# .env.example
PORT=3000

# Supabase Database Configuration
# You can connect using either your Supabase project API credentials or direct PostgreSQL connection string:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Or Direct PostgreSQL Connection URI (optional alternative):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
